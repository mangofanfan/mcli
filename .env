# .env

MCLI_ENABLE_LOG_OUTPUT=true
MCLI_SKIP_ONLINE_AUTH=true
MCLI_NO_PROXY=true
MCLI_MC_GAME_VERSION_MANIFEST_V2_JSON=https://launchermeta.mojang.com/mc/game/version_manifest_v2.json

# MC
MCLI_MC_GAME_DOWNLOAD_LIBRARIES_URL="https://bmclapi2.bangbang93.com/maven/"
